#!/usr/bin/env bash
# tmux の上で、隣のペインにエージェントやシェルを出して操作する。
# エージェントの状態は agent-state-hook が書く ~/.cache/agent-state/<ペイン>.json を読む。
#
#   agentctl start <名前> --kind claude|codex
#   agentctl prompt <名前> "<指示>" [--wait] [--timeout <ミリ秒>]
#   agentctl read <名前> [--lines N]
#   agentctl list
#   agentctl shell <名前>
#   agentctl run <名前> "<コマンド>"
#   agentctl wait-output <名前> --match "<文字列>" [--timeout <ミリ秒>]
#
# 終了コード: 0 成功 / 1 失敗（相手が承認待ち・時間切れ等。理由は標準エラー）/ 2 使い方の誤り
set -euo pipefail

STATE_DIR="$HOME/.cache/agent-state"

die() { echo "agentctl: $*" >&2; exit 1; }
usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
# ミリ秒の時刻。Mac の date は %N を受け付けないので perl で取る
now_ms() {
  local t
  t="$(date +%s%3N 2>/dev/null)"
  case "$t" in
    '' | *[!0-9]*) perl -MTime::HiRes=time -e 'printf "%d\n", time() * 1000' ;;
    *) echo "$t" ;;
  esac
}

[ -n "${TMUX:-}" ] || die "tmux の中で実行してください"

valid_name() {
  [[ "$1" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || { echo "agentctl: 名前は [a-z][a-z0-9_-]{0,31}: $1" >&2; exit 2; }
}

# 名前 -> ペイン ID（%12 の形）。見つからなければ空。
# 空の名前は、名前の無いペイン（@agent_name が空）に当たってしまうので使い方の誤りにする
pane_of() {
  [ -n "$1" ] || usage
  tmux list-panes -a -F '#{pane_id} #{@agent_name}' | awk -v n="$1" '$2 == n { print $1; exit }'
}

need_pane() {
  local p
  p="$(pane_of "$1")"
  [ -n "$p" ] || die "名前 '$1' のペインがありません（agentctl list で確認）"
  echo "$p"
}

# オプションに値があるか（無ければ使い方の誤り）
need_value() { [ "$1" -ge 2 ] || usage; }
# --timeout は数字だけ（算術式に入れるので、それ以外は受け付けない）
check_timeout() {
  [ -z "$1" ] || [[ "$1" =~ ^[0-9]+$ ]] || { echo "agentctl: --timeout はミリ秒の数字: $1" >&2; exit 2; }
}

state_file() { echo "$STATE_DIR/${1#%}.json"; }

# 状態（idle / working / blocked / none）
state_of() {
  local f
  f="$(state_file "$1")"
  if [ -f "$f" ]; then jq -r '.state // "none"' "$f" 2>/dev/null || echo none; else echo none; fi
}

# 状態ファイルの 1 項目（無ければ第 3 引数）
field_of() {
  local f
  f="$(state_file "$1")"
  if [ -f "$f" ]; then jq -r --arg k "$2" --arg d "$3" '.[$k] // $d' "$f" 2>/dev/null || echo "$3"; else echo "$3"; fi
}

# 指示の文の sha256（agent-state-hook と同じ形: 各行の前後の空白と前後の空行を除く）
prompt_sha() {
  local s
  s="$(printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | sed -e '/./,$!d')"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$s" | sha256sum | cut -d' ' -f1
  else
    printf '%s' "$s" | shasum -a 256 | cut -d' ' -f1
  fi
}

# 状態ファイルを hook と同じロックの中で書き換える。
#   locked_update <ペイン> <条件の jq 式> <書き換えの jq 式> [jq の引数...]
# 条件が真のときだけ書き換えて 0 を返す。ロックが取れない・条件が偽・失敗なら 1。
locked_update() {
  local pane="$1" cond="$2" upd="$3" f
  shift 3
  f="$(state_file "$pane")"
  mkdir -p "$STATE_DIR"
  (
    exec 9>"$f.lock" || exit 1
    if command -v flock >/dev/null 2>&1; then flock -w 5 9 || exit 1; fi
    cur='null'
    [ -f "$f" ] && cur="$(cat "$f" 2>/dev/null)"
    [ -n "$cur" ] || cur='null'
    [ "$(printf '%s' "$cur" | jq "$@" "$cond" 2>/dev/null)" = true ] || exit 1
    tmp="$(mktemp "$STATE_DIR/.tmp.XXXXXX")" || exit 1
    if printf '%s' "$cur" | jq "$@" "$upd" >"$tmp" 2>/dev/null; then
      mv -f "$tmp" "$f"
    else
      rm -f "$tmp"; exit 1
    fi
  )
}

# 動いているのがエージェントか（終了してシェルに戻っていないか）
# ネイティブ版の Claude は、Mac の tmux ではコマンド名がバージョン番号（2.1.332 等）になる
agent_running() {
  local pane="$1" kind cur
  kind="$(tmux show-options -p -v -t "$pane" @agent_kind 2>/dev/null || true)"
  cur="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null)" || return 1
  case "$cur" in
    claude | codex | node) return 0 ;;
    [0-9]*.[0-9]*.[0-9]*) [ "$kind" = claude ] ;;
    *) return 1 ;;
  esac
}

# Esc の中断では hook が来ず、状態ファイルが working のまま残る。作業中は画面の下に
# 「esc to interrupt」が出るので、working なのに画面の最後の 10 行に「esc to」が無ければ、
# 中断されたとみなして idle に書き直す（書き直したら 0 を返す）。
#   Claude: 1 秒空けて 2 回続けて無いとき
#   Codex : 文章を書き出している間はこの行を消すので、2 秒空けて 2 回続けて無く、
#           かつ 2 回の画面が同じ（書き出しが止まっている）とき
has_indicator() {
  printf '%s\n' "$1" |
    awk '{ buf[NR] = $0 } /[^[:space:]]/ { last = NR } END { for (i = 1; i <= last; i++) print buf[i] }' |
    tail -n 10 | grep -qiF 'esc to'
}
fix_interrupted() {
  local pane="$1" kind ts0 s1 s2 width
  # 狭いペインでは画面下の文字が「esc to …」のように切れるので、esc to までで判定する。
  # 幅 30 文字未満ではそれも切れうるので、中断の判定をしない（作業中のまま扱う）
  width="$(tmux display-message -p -t "$pane" '#{pane_width}' 2>/dev/null)" || return 1
  [ "${width:-0}" -ge 30 ] || return 1
  kind="$(tmux show-options -p -v -t "$pane" @agent_kind 2>/dev/null || true)"
  # 画面を撮る前の状態の時刻。書き直すのは、その後に hook が何も書いていないときだけ
  ts0="$(field_of "$pane" ts "")"
  [ -n "$ts0" ] || return 1
  s1="$(tmux capture-pane -p -t "$pane" 2>/dev/null)" || return 1
  has_indicator "$s1" && return 1
  if [ "$kind" = codex ]; then sleep 2; else sleep 1; fi
  s2="$(tmux capture-pane -p -t "$pane" 2>/dev/null)" || return 1
  has_indicator "$s2" && return 1
  if [ "$kind" = codex ] && [ "$s1" != "$s2" ]; then return 1; fi
  locked_update "$pane" \
    '. != null and .state == "working" and ((.ts // "") | tostring) == $ts0' \
    '.state = "idle" | .event = "agentctl-interrupted" | .ts = $now | .pending = []' \
    --arg ts0 "$ts0" --argjson now "$(now_ms)"
}

# 新しいペインを作って ID を返す。
#   呼んだペインのウィンドウに agentctl のペイン（名前付き）がまだ無ければ、呼んだペインの右に出す。
#   あれば、それらのうち一番下のペインを上下に分けて右の列に積み、右の列の高さをそろえる。
split_pane() {
  local caller="${TMUX_PANE:-}" bottom pane
  bottom="$(tmux list-panes -t "$caller" -F '#{pane_bottom} #{pane_id} #{@agent_name}' |
    awk -v c="$caller" '$2 != c && $3 != "" { print }' | sort -n | tail -n 1 | cut -d' ' -f2)"
  if [ -z "$bottom" ]; then
    tmux split-window -d -h -c "$PWD" -t "$caller" -P -F '#{pane_id}'
    return
  fi
  pane="$(tmux split-window -d -v -c "$PWD" -t "$bottom" -P -F '#{pane_id}')"
  tmux select-layout -E -t "$pane" 2>/dev/null || true
  echo "$pane"
}

cmd_start() {
  local name="${1:-}"; shift || true
  local kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind) need_value $#; kind="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$name" ] || usage
  valid_name "$name"
  case "$kind" in claude | codex) ;; *) echo "agentctl: --kind は claude か codex" >&2; exit 2 ;; esac
  [ -z "$(pane_of "$name")" ] || die "名前 '$name' は使用中です"

  local pane
  pane="$(split_pane)"
  tmux set-option -p -t "$pane" @agent_name "$name"
  tmux set-option -p -t "$pane" @agent_kind "$kind"
  rm -f "$(state_file "$pane")"
  # Codex は既定では共有の常駐サーバー（app-server daemon）の中で hook を動かす。
  # 常駐サーバーには起動したペインの TMUX_PANE が無いので、--no-daemon でペインの中で動かす。
  local launch="$kind"
  [ "$kind" = codex ] && launch="codex --no-daemon"
  tmux send-keys -t "$pane" -l "$launch"
  tmux send-keys -t "$pane" Enter

  # SessionStart で idle になるまで待つ（最長 30 秒）
  # Codex は起動しても SessionStart を呼ばない（最初の指示のときに呼ぶ）ので、
  # Codex だけは画面に入力欄の文字が出たら idle を書く。更新確認などの画面には出ない文字。
  local deadline=$(( $(now_ms) + 30000 )) st
  while [ "$(now_ms)" -lt "$deadline" ]; do
    st="$(state_of "$pane")"
    if [ "$st" = none ] && [ "$kind" = codex ] &&
      tmux capture-pane -p -t "$pane" | grep -qF 'Ask Codex to do anything'; then
      # hook がまだ何も書いていないときだけ、ロックの中で仮の idle を置く
      locked_update "$pane" '. == null' \
        '{agent:"codex", state:"idle", event:"agentctl-start", session_id:"", pane:$pane, ts:$now, prompt_ts:0, prompt_sha:"", pending:[]}' \
        --arg pane "$pane" --argjson now "$(now_ms)" || true
      st="$(state_of "$pane")"
    fi
    if [ "$st" = idle ]; then
      echo "$name $pane $kind idle"
      return 0
    fi
    sleep 0.3
  done
  echo "$name $pane $kind not_ready" >&2
  die "30 秒以内に入力待ちになりませんでした。agentctl read $name で画面を確認してください"
}

cmd_shell() {
  local name="${1:-}"; shift || true
  [ $# -eq 0 ] || usage
  [ -n "$name" ] || usage
  valid_name "$name"
  [ -z "$(pane_of "$name")" ] || die "名前 '$name' は使用中です"
  # シェルもエージェントと同じく、右の列にペインを出す（フォーカスは移さない）
  local pane
  pane="$(split_pane)"
  tmux set-option -p -t "$pane" @agent_name "$name"
  tmux set-option -p -t "$pane" @agent_kind shell
  echo "$name $pane shell"
}

cmd_prompt() {
  local name="${1:-}" text="${2:-}"; shift 2 || usage
  local wait=0 timeout=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait) wait=1; shift ;;
      --timeout) need_value $#; timeout="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$name" ] || usage
  [ -n "$text" ] || usage
  check_timeout "$timeout"
  local pane kind st
  pane="$(need_pane "$name")"
  kind="$(tmux show-options -p -v -t "$pane" @agent_kind 2>/dev/null || true)"
  [ "$kind" != shell ] || die "'$name' はシェルです。agentctl run を使ってください"
  # 同じペインへの送信は 1 つずつ。受け付けを確かめるか 10 秒たつまで送信ロックを持つ
  local sendlock
  sendlock="$(state_file "$pane").send.lock"
  mkdir -p "$STATE_DIR"
  exec 8>"$sendlock" || die "送信ロックを作れません: $sendlock"
  if command -v flock >/dev/null 2>&1; then
    flock -n 8 || die "'$name' には別の agentctl prompt が送信中です。終わってから送ってください"
  fi

  st="$(state_of "$pane")"
  if [ "$st" = working ] && fix_interrupted "$pane"; then st=idle; fi
  # 入力待ち（idle）と hook で確かめられたときだけ送る。
  # 状態が無い（none）ときは、更新確認などの画面に Enter が入って選択肢を押してしまうので送らない。
  case "$st" in
    idle) ;;
    blocked) die "'$name' は承認待ち（blocked）です。agentctl read $name で確認してください" ;;
    working) die "'$name' は作業中（working）です。終わってから送ってください" ;;
    *) die "'$name' の状態が不明（$st）です。入力待ちと確かめられないので送りません。agentctl read $name で確認してください" ;;
  esac
  # 状態ファイルが idle のままエージェントが終了していると、ペインはシェルに戻っていて
  # 指示がコマンドとして実行されてしまう。送る直前に、動いているのがエージェントか確かめる。
  agent_running "$pane" ||
    die "'$name' のペインで動いているのは '$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null)' で、エージェントではありません（終了した可能性）。送りません"

  local start buf="agentctl-$$" mysha
  start="$(now_ms)"
  mysha="$(prompt_sha "$text")"
  # 貼り付け（アプリが bracketed paste を有効にしていれば -p で囲む）してから Enter。
  # バッファは tmux 全体で共有なので、呼び出しごとに別の名前にする
  printf '%s' "$text" | tmux load-buffer -b "$buf" -
  if ! tmux paste-buffer -p -d -b "$buf" -t "$pane"; then
    tmux delete-buffer -b "$buf" 2>/dev/null || true
    die "'$name' のペインに貼り付けられませんでした"
  fi
  sleep 0.3
  tmux send-keys -t "$pane" Enter

  local deadline=""
  [ -n "$timeout" ] && deadline=$(( start + timeout ))
  # 送った指示で UserPromptSubmit が来たことを 10 秒以内に確かめる（--wait なしでもここまでは待つ）。
  # 時刻が送った後で、指示の文の sha256 が送った文と同じなら受け付け（定期タスクなどの指示と区別する）。
  # Codex など hook の入力に指示の文が無いとき（prompt_sha が空）は時刻だけで判断する。
  local accepted=0 gate=$(( start + 10000 )) t sha
  while :; do
    t="$(now_ms)"
    if [ -n "$deadline" ] && [ "$t" -ge "$deadline" ]; then
      die "時間切れ（state=$(state_of "$pane")）。送った指示が届いていないとは限りません。read で確認してください"
    fi
    # 待っている間にペインが閉じられた・エージェントが終了した・状態ファイルが消えたら止める
    tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 ||
      die "'$name' のペインがなくなりました"
    agent_running "$pane" || die "'$name' のエージェントが終了しました"
    st="$(state_of "$pane")"
    [ "$st" != none ] || die "'$name' の状態ファイルがなくなりました（エージェントが終了した可能性）"
    if [ "$accepted" = 0 ]; then
      sha="$(field_of "$pane" prompt_sha "")"
      if [ "$(field_of "$pane" prompt_ts 0)" -ge "$start" ] && { [ -z "$sha" ] || [ "$sha" = "$mysha" ]; }; then
        accepted=1
        exec 8>&-
        [ "$wait" = 1 ] || { echo "sent"; return 0; }
      elif [ "$t" -ge "$gate" ]; then
        die "10 秒以内に作業を始めませんでした（stalled）。read で確認してください"
      fi
    else
      case "$st" in
        idle) echo "idle"; return 0 ;;
        blocked) echo "blocked"; die "'$name' が承認待ち（blocked）で止まりました。agentctl read $name で確認してください" ;;
        working) if fix_interrupted "$pane"; then echo "idle"; return 0; fi ;;
      esac
    fi
    sleep 0.5
  done
}

cmd_read() {
  local name="${1:-}"; shift || true
  local lines=50
  while [ $# -gt 0 ]; do
    case "$1" in
      --lines) need_value $#; lines="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$name" ] || usage
  [[ "$lines" =~ ^[0-9]+$ ]] || { echo "agentctl: --lines は数字" >&2; exit 2; }
  local pane
  pane="$(need_pane "$name")"
  # 画面下の空行を除いてから、最後の N 行を出す
  tmux capture-pane -p -J -t "$pane" -S "-$lines" |
    awk '{ buf[NR] = $0 } /[^[:space:]]/ { last = NR } END { for (i = 1; i <= last; i++) print buf[i] }' |
    tail -n "$lines"
}

cmd_list() {
  printf '%-16s %-6s %-7s %-8s %s\n' NAME PANE KIND STATE CWD
  # 区切りにタブを使うと、空の欄が詰められて列がずれる（タブは空白扱い）ので | にする
  tmux list-panes -a -F '#{pane_id}|#{@agent_name}|#{@agent_kind}|#{pane_current_path}' |
    while IFS='|' read -r pane name kind cwd; do
      [ -n "$name" ] || continue
      local st=-
      [ "$kind" = shell ] || st="$(state_of "$pane")"
      printf '%-16s %-6s %-7s %-8s %s\n' "$name" "$pane" "$kind" "$st" "$cwd"
    done
}

cmd_run() {
  local name="${1:-}" cmd="${2:-}"
  if [ -z "$name" ] || [ -z "$cmd" ]; then usage; fi
  local pane
  pane="$(need_pane "$name")"
  tmux send-keys -t "$pane" -l "$cmd"
  tmux send-keys -t "$pane" Enter
  echo "sent"
}

cmd_wait_output() {
  local name="${1:-}"; shift || true
  local match="" timeout=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --match) need_value $#; match="$2"; shift 2 ;;
      --timeout) need_value $#; timeout="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  if [ -z "$name" ] || [ -z "$match" ]; then usage; fi
  check_timeout "$timeout"
  local pane deadline=""
  pane="$(need_pane "$name")"
  [ -n "$timeout" ] && deadline=$(( $(now_ms) + timeout ))
  local screen
  while :; do
    # 画面を読めない（ペインが消えた等）ときは待ち続けずに止める
    screen="$(tmux capture-pane -p -J -t "$pane" -S -500 2>/dev/null)" ||
      die "'$name' の画面を読めません（ペインが閉じられた可能性）"
    if printf '%s\n' "$screen" | grep -qF -- "$match"; then
      echo "matched"
      return 0
    fi
    if [ -n "$deadline" ] && [ "$(now_ms)" -ge "$deadline" ]; then
      die "時間切れ: '$match' は出ませんでした"
    fi
    sleep 0.5
  done
}

sub="${1:-}"; shift || true
case "$sub" in
  start) cmd_start "$@" ;;
  prompt) cmd_prompt "$@" ;;
  read) cmd_read "$@" ;;
  list) cmd_list ;;
  shell) cmd_shell "$@" ;;
  run) cmd_run "$@" ;;
  wait-output) cmd_wait_output "$@" ;;
  *) usage ;;
esac
